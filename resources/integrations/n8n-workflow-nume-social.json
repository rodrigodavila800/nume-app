{
  "name": "NUME Social Engine - Publicação Automatizada de Vídeos",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "nume-publish-trigger",
        "options": {}
      },
      "id": "11111111-1111-1111-1111-111111111111",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://nume.app/api/v1/social/publish",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.NUME_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\n  \"email\": \"{{ $json.body.email }}\",\n  \"video_url\": \"{{ $json.body.video_url }}\",\n  \"title\": \"{{ $json.body.title }}\",\n  \"platforms\": {{ JSON.stringify($json.body.platforms || [\"instagram\", \"tiktok\", \"youtube\"]) }}\n}",
        "options": {}
      },
      "id": "22222222-2222-2222-2222-222222222222",
      "name": "Post to NUME Social Engine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        500,
        300
      ]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Post to NUME Social Engine",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
