APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
 
# Google Gemini / Sofi IA
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Sofi IA via Laravel AI SDK (piloto; ver config/sofi.php)
SOFI_USE_AI_SDK=false
SOFI_AI_PROVIDER=gemini
SOFI_AI_MODEL=
SOFI_AI_TIMEOUT=15

# Limites do chat publico da vitrine (por IP e por vitrine)
SOFI_CHAT_PER_MINUTE=6
SOFI_CHAT_PER_HOUR_IP=40
SOFI_CHAT_PER_HOUR_TENANT=400
SOFI_CHAT_RESET_PER_MINUTE=5

# Video hospedado na NUME (disco privado; ajuste tambem upload_max_filesize/post_max_size no PHP e client_max_body_size no nginx)
VIDEO_DISK=videos
VIDEO_MAX_UPLOAD_MB=512
VIDEO_SIGNED_URL_MINUTES=120

# Google OAuth (login do portal e conexao do canal do YouTube usam o mesmo cliente OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Vazio: usa {APP_URL}/portal/redes-sociais/oauth/youtube/callback (cadastre essa URI no Google Cloud)
GOOGLE_YOUTUBE_REDIRECT_URI=

# Nume Social Engine: native (app proprio, exige canal conectado) ou upload_post
SOCIAL_ROUTE_YOUTUBE=native
# private ate o app passar pela auditoria do Google (antes disso o YouTube forca private de qualquer jeito)
SOCIAL_YOUTUBE_PRIVACY=private
SOCIAL_YOUTUBE_UPLOAD_TIMEOUT=3600
# Precisa ser maior que SOCIAL_YOUTUBE_UPLOAD_TIMEOUT + 120, senao o video pode sair duplicado
SOCIAL_UPLOADS_RETRY_AFTER=4000

# App da Meta (Facebook Login for Business): Pagina do Facebook + Instagram profissional
META_APP_ID=
META_APP_SECRET=
# Opcional: configuracao do Facebook Login for Business (substitui a lista de permissoes)
META_LOGIN_CONFIG_ID=
# Vazio: usa {APP_URL}/portal/redes-sociais/oauth/meta/callback
META_REDIRECT_URI=
META_GRAPH_VERSION=v26.0
SOCIAL_ROUTE_INSTAGRAM=native
SOCIAL_ROUTE_FACEBOOK=native

# Caso de uso Threads do app da Meta (ID e segredo proprios no painel)
THREADS_APP_ID=
THREADS_APP_SECRET=
# Vazio: usa {APP_URL}/portal/redes-sociais/oauth/threads/callback
THREADS_REDIRECT_URI=
SOCIAL_ROUTE_THREADS=native

# App do TikTok for Developers (Login Kit + Content Posting API / Direct Post)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Vazio: usa {APP_URL}/portal/redes-sociais/oauth/tiktok/callback
TIKTOK_REDIRECT_URI=
SOCIAL_ROUTE_TIKTOK=native

# App do LinkedIn Developers (Sign In with LinkedIn using OpenID Connect + Share on LinkedIn)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Vazio: usa {APP_URL}/portal/redes-sociais/oauth/linkedin/callback
LINKEDIN_REDIRECT_URI=
LINKEDIN_API_VERSION=202610
SOCIAL_ROUTE_LINKEDIN=native

# App do Pinterest Developers (API v5)
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
# Vazio: usa {APP_URL}/portal/redes-sociais/oauth/pinterest/callback
PINTEREST_REDIRECT_URI=
# Em Trial, se o Pinterest exigir: https://api-sandbox.pinterest.com/v5
PINTEREST_API_BASE=https://api.pinterest.com/v5
SOCIAL_ROUTE_PINTEREST=native

ANTHROPIC_API_KEY=
